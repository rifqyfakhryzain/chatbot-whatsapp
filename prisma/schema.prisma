generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  phoneNumber String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shift {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  startTime String?
  endTime   String?
  workHours Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}